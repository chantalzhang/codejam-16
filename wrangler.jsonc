// Cloudflare deploy config: built pages from dist/ plus the relay. Deploy: npm run deploy
{
  "name": "browser-swarm",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "SWARM", "class_name": "Swarm" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Swarm"] }]
}
